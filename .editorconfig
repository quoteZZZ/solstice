# Solstice EditorConfig
# 由 VSCode 的 editorconfig.editorconfig 扩展读取（工作区推荐扩展之一）。
# 作用：跨编辑器统一编码 / 换行 / 缩进。
# 仓库里只有文档（specs/）、原型（prototypes/，HTML+CSS+JS）、脚本（tools/，Python）三类东西。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---- 原型代码：两格缩进，与现有 prototypes/solstice/** 一致 ----
[*.{js,mjs,css,html}]
indent_size = 2

# ---- Python 脚本（tools/）：PEP 8 四格 ----
[*.py]
indent_size = 4
max_line_length = 120

# ---- 数据与配置 ----
[*.{json,jsonc,yml,yaml,ini}]
indent_size = 2

# ---- 文档 ----
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ---- 第三方与生成物：不受本文件约束 ----
[**/vendor/**]
[**/node_modules/**]
