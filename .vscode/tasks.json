// 工作区任务（Ctrl+Shift+B 构建 / Ctrl+Shift+P → Run Task）
// 所有任务均以 -ExecutionPolicy Bypass 调用 tools\ 与 studio\ 下的脚本。
{
  "version": "2.0.0",
  "tasks": [
    // ==================== 构建 ====================
    {
      "label": "Solstice: 构建 SolsticeEditor (Development)",
      "detail": "编译 C++ 主模块。改过头文件/反射宏/模块时，请先关闭虚幻编辑器。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build/build.ps1",
        "-Target",
        "SolsticeEditor",
        "-Config",
        "Development"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Solstice: 构建 SolsticeEditor (Shipping)",
      "detail": "发行配置编译，用于性能验收（M6）。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build/build.ps1",
        "-Target",
        "SolsticeEditor",
        "-Config",
        "Shipping"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Solstice: 清理并全量重编",
      "detail": "删中间产物后重编。仅在 UBT 行为异常时使用（耗时长）。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build/build.ps1",
        "-Target",
        "SolsticeEditor",
        "-Config",
        "Development",
        "-Clean"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },

    // ==================== 工程文件 ====================
    {
      "label": "Solstice: 生成工程文件 (Solution / cpptools)",
      "detail": "生成 game\\Solstice.sln，供 ms-vscode.cpptools 提供 IntelliSense。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build/gen-projectfiles.ps1",
        "-Mode",
        "Solution"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Solstice: 生成工程文件 (ClangDb / clangd)",
      "detail": "生成 game\\compile_commands.json，供 clangd（路线 B）。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build/gen-projectfiles.ps1",
        "-Mode",
        "ClangDb"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Solstice: 配置 VS Code (写入引擎环境变量)",
      "detail": "探测引擎并写入用户级环境变量 SOLSTICE_UE_ENGINE_ROOT；.vscode 配置通过 ${env:...} 引用它。跑完需重启 VS Code。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/env/configure-vscode.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Solstice: 启动编辑器",
      "detail": "用 UnrealEditor 打开 game\\Solstice.uproject。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run/launch-editor.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Solstice: 启动编辑器（含 MCP 服务器）",
      "detail": "同上，但额外传 -ModelContextProtocolStartServer：编辑器进程内的官方 MCP 服务器监听 127.0.0.1:8000/mcp，AI 可据此边改边观察。详见 docs\\ops\\AI-TOOLING.md §2。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run/launch-editor.ps1",
        "-Mcp"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ==================== 环境 ====================
    {
      "label": "环境: 体检",
      "detail": "只读检查工具链是否齐备（Epic / UE / VS2022 / ComfyUI / GPU / 磁盘）。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/env/check-env.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "环境: 探测虚幻引擎",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/env/find-ue.ps1",
        "-All"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },

    // ==================== 自检 ====================
    // 与提交钩子（tools\hooks\pre-commit）和 CI（.github\workflows\checks.yml）跑的是同两条命令。
    {
      "label": "自检: 契约校验（schema + 交叉引用 + 本地化 key）",
      "detail": "tools\\checks\\validate-contracts.py：shared\\schema\\ 与 game\\Config\\Solstice\\Data\\ 逐对校验 + 卡/物种 id 查重 + 存档信封样例 + 中英 key 对齐。",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/checks/validate-contracts.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "自检: 链接校验（文档相对链接）",
      "detail": "tools\\checks\\check-links.py：解析全部文档相对链接，有断链即退出码 1。",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/checks/check-links.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },

    // ==================== 回归 ====================
    {
      "label": "回归: 无头确定性基准（SolsticeBench）",
      "detail": "tools\\run\\bench.ps1：同种子跑两遍内核比对世界结构摘要，不一致即硬失败。不碰 RHI / World / GameMode，无需编辑器。",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run/bench.ps1",
        "-Days",
        "2"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },

    // ==================== 生图线 ====================
    // 唯一入口是 studio\tools\comfy_batch.py（见 docs\tech\STRUCTURE.md §4）。
    // ComfyUI 自身的启动在本仓库之外（默认装在 D:\ComfyUI），故不在此提供启动任务。
    {
      "label": "生图: 体检 ComfyUI（探针 + 列出模型）",
      "detail": "comfy_batch.py --check：探 ComfyUI API 是否就绪并列出可用 checkpoint。不占 GPU。",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/studio/tools/comfy_batch.py", "--check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "生图: 跑纸纹批次（studio\\jobs\\paper-textures.jsonl）",
      "detail": "按 jobs 清单调 ComfyUI 出图并写入 studio\\out\\manifest.jsonl（逐张留档：模型 / prompt / seed / 日期）。",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/studio/tools/comfy_batch.py",
        "--jobs",
        "${workspaceFolder}/studio/jobs/paper-textures.jsonl"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },

    // ==================== 版本控制 ====================
    {
      "label": "Git: 提交全部改动",
      "detail": "提交信息请用英文简短祈使句（仓库约定）。",
      "type": "shell",
      "command": "git",
      "args": ["commit", "-a", "-m", "${input:commitMessage}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "英文提交信息（简短祈使句）",
      "default": "chore: update"
    }
  ]
}
