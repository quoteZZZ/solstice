// 调试配置（F5）
// cppvsdbg = Visual Studio 调试引擎，需要 VS2022 生成工具已安装（见 docs/ops/ENV.md）
// 引擎路径走环境变量 ${env:SOLSTICE_UE_ENGINE_ROOT}（由 tools\env\configure-vscode.ps1 写入），
// 本文件因此与主机无关，可安全入库；改变量后需重启 VS Code。
{
  "version": "0.2.0",
  "configurations": [
    {
      // 日常首选：编辑器常驻，改完 C++ 用 Live Coding 热编译后附加调试
      "name": "Solstice: 附加到 UnrealEditor",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}/game/Binaries/Win64",
      "sourceFileMap": {}
    },
    {
      // 干净复现：由 VSCode 直接拉起编辑器并进入游戏（-game 跳过编辑器 UI）
      "name": "Solstice: 启动 UnrealEditor（-game）",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${env:SOLSTICE_UE_ENGINE_ROOT}/Engine/Binaries/Win64/UnrealEditor.exe",
      "args": [
        "${workspaceFolder}/game/Solstice.uproject",
        "-game",
        "-log",
        "-windowed",
        "-ResX=1600",
        "-ResY=900"
      ],
      "cwd": "${workspaceFolder}/game",
      "environment": [],
      "console": "externalTerminal",
      "symbolSearchPath": "${workspaceFolder}/game/Binaries/Win64"
    },
    {
      // 完整编辑器（要拖资产、连蓝图时用这个）
      "name": "Solstice: 启动 UnrealEditor（编辑器 UI）",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${env:SOLSTICE_UE_ENGINE_ROOT}/Engine/Binaries/Win64/UnrealEditor.exe",
      "args": ["${workspaceFolder}/game/Solstice.uproject", "-log"],
      "cwd": "${workspaceFolder}/game",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      // M0 的自动化证明：同一种子跑两遍内核，比对世界结构摘要，不一致即硬失败。
      // 走 tools\run\bench.ps1（内部是 -run=SolsticeBench），不碰 RHI / World / GameMode，
      // 所以不开编辑器也能跑。旧的 SolsticeSim 独立目标已在 M0 取消（见 docs/tech/STRUCTURE.md §3）。
      "name": "Solstice: 无头回归 bench（-Days 2）",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/run/bench.ps1",
      "args": ["-Days", "2"],
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    },
    {
      // 调试 tools/ 下的 PowerShell 脚本
      "name": "PowerShell: 调试当前脚本",
      "type": "PowerShell",
      "request": "launch",
      "script": "${file}",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    }
  ]
}
