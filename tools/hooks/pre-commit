#!/bin/sh
# Solstice pre-commit hook: run the two Python self-checks (stdlib-only).
# Install once per clone:  powershell -ExecutionPolicy Bypass -File tools\hooks\install-hooks.ps1
# Uninstall:               git config --unset core.hooksPath
echo '[solstice] check-links ...'
python tools/checks/check-links.py || exit 1
echo '[solstice] validate-contracts ...'
python tools/checks/validate-contracts.py || exit 1
echo '[solstice] check-materials ...'
python tools/checks/check-materials.py || exit 1
echo '[solstice] check-layers ...'
python tools/checks/check-layers.py || exit 1
exit 0
